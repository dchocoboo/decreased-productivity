{
  "manifest_version": 3,
  "name": "Decreased Productivity",
  "version": "1.0.0",
  "description": "Discreetly surf the web. Control page colors, fonts, images and multimedia.",
  "minimum_chrome_version": "120",
  "default_locale": "en",
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": "img/addressicon/coffee-disabled.png",
    "default_title": "Decreased Productivity"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "contextMenus", "tabs", "scripting", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/settings.js", "js/style.js", "js/dp.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
